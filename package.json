{
  "name": "rent-and-trippin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run --project db",
    "test:e2e": "vitest run --project e2e",
    "db:push": "set -a && . ./.env.admin.local && set +a && supabase db push --linked --password \"$SUPABASE_DB_PASSWORD\" --yes",
    "db:migrations": "set -a && . ./.env.admin.local && set +a && supabase migration list --linked --password \"$SUPABASE_DB_PASSWORD\"",
    "db:types": "set -a && . ./.env.admin.local && set +a && supabase gen types typescript --linked > lib/database.types.ts",
    "seed:admin": "node scripts/seed-admin.mjs",
    "auth:configure": "node scripts/configure-auth.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
