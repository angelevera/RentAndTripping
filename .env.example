# Plantilla de variables de entorno. NO poner valores reales aquí — este archivo
# se sube al repositorio; los valores reales van solo en .env.local y
# .env.admin.local (ambos ignorados por git, nunca se suben).

# ---------------------------------------------------------------------------
# .env.local — leído por la app de Next.js en tiempo de ejecución
# ---------------------------------------------------------------------------

# Project Settings → Data API → Project URL (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# .env.admin.local — la app de Next.js NUNCA carga este archivo. Solo lo leen
# los scripts de CLI (scripts/*.mjs) y Vitest.
# ---------------------------------------------------------------------------

# Project Settings → API Keys → Secret keys (sb_secret_...) — acceso total,
# nunca debe llegar al navegador ni a git.
SUPABASE_SECRET_KEY=

# Project Settings → General → Project ID
SUPABASE_PROJECT_REF=

# La contraseña de la base de datos elegida al crear el proyecto en Supabase
SUPABASE_DB_PASSWORD=

# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Contraseña inicial de la cuenta real del admin (usada por Plan 01-02 / seed:admin)
ADMIN_INITIAL_PASSWORD=

# Opcional — dominio para los correos de las cuentas de prueba automatizadas
# (por defecto: example.com)
TEST_EMAIL_DOMAIN=

# Opcional — URL base para los tests e2e si ya hay un servidor corriendo
# (si no se define, el harness de tests levanta su propio `next dev`)
E2E_BASE_URL=
